{
  "name": "@proxy-shopping/core",
  "version": "0.1.0",
  "description": "Protocol core for proxy-shopping: keys, Nostr messaging, trust lists, BTC/EVM escrow and role clients",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./p2p": {
      "types": "./dist/p2p.d.ts",
      "import": "./dist/p2p.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./testing/node": {
      "types": "./dist/testing/node.d.ts",
      "import": "./dist/testing/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir src",
    "test:integration": "vitest run --dir test/integration",
    "test:interop": "vitest run --dir test/interop"
  },
  "dependencies": {
    "@libp2p/circuit-relay-v2": "^4.2.13",
    "@libp2p/crypto": "^5.1.23",
    "@libp2p/gossipsub": "^17.1.2",
    "@libp2p/identify": "^4.1.14",
    "@libp2p/interface": "^3.3.0",
    "@libp2p/noise": "^17.0.3",
    "@libp2p/peer-id": "^6.0.15",
    "@libp2p/webrtc": "^6.0.33",
    "@libp2p/websockets": "^10.1.21",
    "@libp2p/yamux": "^8.0.3",
    "@multiformats/multiaddr": "^13.0.3",
    "@noble/ciphers": "~1.3.0",
    "@noble/curves": "~1.9.7",
    "@noble/hashes": "~1.8.0",
    "@scure/base": "~1.2.6",
    "@scure/bip32": "~1.7.0",
    "@scure/bip39": "~1.6.0",
    "@scure/btc-signer": "~1.8.1",
    "libp2p": "^3.3.11",
    "nostr-tools": "~2.25.2",
    "viem": "~2.56.9",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "fake-indexeddb": "^6.0.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
